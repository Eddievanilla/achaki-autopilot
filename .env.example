# ============================================================
# ACHAki Autopilot — .env.example
# Copie este arquivo para .env e configure os valores locais.
# NUNCA comite o arquivo .env com credenciais reais.
# ============================================================

# ─── Fase 1: Browser ────────────────────────────────────────
BROWSER_HEADLESS=false
BROWSER_PROFILE_PATH=./data/browser-profile
LOG_LEVEL=info

# ─── Fase 2: OpenRouter ─────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key

# Modelo para decisões (rankear produtos, selecionar ofertas, analisar desempenho)
# Exemplos: openai/gpt-4o-mini  |  google/gemini-flash-1.5  |  meta-llama/llama-3.1-8b-instruct
OPENROUTER_DECISION_MODEL=

# Modelo para geração de conteúdo (títulos, legendas, hashtags)
# Pode ser igual ao de decisão ou um modelo mais barato
OPENROUTER_CONTENT_MODEL=

# Limites de tokens e comportamento
OPENROUTER_MAX_TOKENS_DECISION=1000
OPENROUTER_MAX_TOKENS_CONTENT=500
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_RETRIES=2

# ============================================================
# ============================================================
# FASE 4.2 — APIs Oficiais (API-First)
# ============================================================

# Mercado Livre Developers API (Fase 4.2)
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_ACCESS_TOKEN=
MERCADOLIVRE_REFRESH_TOKEN=

# ============================================================
# FASES FUTURAS — não ativas ainda
# ============================================================


{
  "rewrites": [
    { "source": "/go/:trackingId", "destination": "/api/go?trackingId=:trackingId" },
    { "source": "/auth/facebook/callback", "destination": "/api/facebook-callback" },
    { "source": "/auth/facebook/callback/(.*)", "destination": "/api/facebook-callback" },
    { "source": "/api/auth/facebook/callback", "destination": "/api/facebook-callback" }
  ]
}
